      "isoDate": "1977-01-18T17:00:00",
      "displayDate": "Jan 18, 1977 • 5:00 PM",
      "content": "For veterans whose remains are not recovered, the VA provides memorial markers for placement in National Cemeteries or other authorized locations.",
      "person_id": "p_va_rep",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-19-1977%20-%20Page%2027-1.jpg"
