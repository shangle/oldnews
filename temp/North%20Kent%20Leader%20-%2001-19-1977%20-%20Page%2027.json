      "author": "Recent Veteran",
      "handle": "@HomeFromNam",
      "isoDate": "1977-01-17T14:30:00",
      "displayDate": "Jan 17, 1977 • 2:30 PM",
      "content": "Just learned that the burial allowance eligibility covers everything from the Spanish-American War to the Vietnam Era. It's a small comfort to know this support is there for us.",
      "person_id": "p_veteran_01",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-19-1977%20-%20Page%2027-1.jpg"
    },
    {
