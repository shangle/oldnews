      "handle": "@VARepOfficial",
      "isoDate": "1977-01-17T16:15:00",
      "displayDate": "Jan 17, 1977 • 4:15 PM",
      "content": "Regarding burial in National Cemeteries: an additional $150 plot allowance is available if you choose a non-government cemetery, provided the burial is not in a National one.",
      "person_id": "p_va_rep",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-19-1977%20-%20Page%2027-1.jpg"
    },
