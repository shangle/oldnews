      "isoDate": "1977-01-18T09:00:00",
      "displayDate": "Jan 18, 1977 • 9:00 AM",
      "content": "Remember that plot allowances are for those discharged under conditions other than dishonorable. We have all the full information on eligibility criteria here at the office.",
      "person_id": "p_secretary_01",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-19-1977%20-%20Page%2027-1.jpg"
