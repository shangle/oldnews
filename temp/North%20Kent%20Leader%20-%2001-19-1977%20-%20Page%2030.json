      "isoDate": "1977-01-19T12:05:00",
      "displayDate": "Jan 19, 1977 • 12:05 PM",
      "content": "If I lived in the White House, I’d probably feel pretty safe and well-cared for. I mean, I would probably feel quite well with all of the doctors the White House has at its disposal!",
      "person_id": "p_brian_layer",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-19-1977%20-%20Page%2030.pdf"
    },
