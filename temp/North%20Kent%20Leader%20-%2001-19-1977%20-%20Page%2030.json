      "author": "Steve Johnson",
      "handle": "@steve_j_kc",
      "isoDate": "1977-01-11T20:30:00",
      "displayDate": "Jan 11, 1977 • 8:30 PM",
      "content": "What a comeback for the JV squad! Down going into the fourth, but we ran off ten unanswered points to steal the 40-37 win from Hesperia. Finished with 16 points and some hard-earned rebounds.",
      "person_id": "p_steve_johnson",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-19-1977%20-%20Page%2030.pdf"
