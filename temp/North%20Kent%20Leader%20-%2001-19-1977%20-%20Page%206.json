      "author": "National Policy Critic",
      "handle": "@policy_watch",
      "isoDate": "1977-01-19T09:45:00",
      "displayDate": "Jan 19, 1977 • 9:45 AM",
      "content": "The food production line is taking a heavy turn on the backs of family farmers. When farm prices go up, retail prices skyrocket, but when farm prices decline, retail prices seem to stay exactly where they are.",
      "person_id": "p_policy_critic",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-19-1977%20-%20Page%206.pdf"
    },
