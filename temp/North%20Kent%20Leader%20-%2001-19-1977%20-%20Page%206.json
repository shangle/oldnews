      "author": "Pauline Spray",
      "handle": "@pauline_spray",
      "isoDate": "1977-01-19T08:30:00",
      "displayDate": "Jan 19, 1977 • 8:30 AM",
      "content": "We need to do a better job of connecting our urban neighbors with our local farms. Too many people think the supermarket is where food begins, rather than just the last stop on a very long journey.",
      "person_id": "p_012",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-19-1977%20-%20Page%206.pdf"
    },
    {
      "id": "post_pork_05",
