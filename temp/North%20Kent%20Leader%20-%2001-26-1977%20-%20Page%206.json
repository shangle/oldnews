      "isoDate": "1977-01-26T08:45:00",
      "displayDate": "Jan 26, 1977 • 8:45 AM",
      "content": "Our summer program is open to preschoolers, second, fifth, and eighth graders living in the Rockford school district. It is such an important preventative step for our students.",
      "person_id": "p_carroll_wright",
      "sourcePdf": "temp/North%20Kent%20Leader%20-%2001-26-1977%20-%20Page%206-1.jpg"
